pkgname=mirvdesk
pkgver=1.5.0
pkgrel=0
epoch=
pkgdesc="MirvDesk self-hosted remote desktop client"
arch=('x86_64')
url="https://github.com/mirivlad/mirvdesk-client"
license=('AGPL-3.0')
groups=()
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libappindicator-gtk3' 'gst-plugins-base' 'gst-plugin-pipewire')
makedepends=()
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=pacman_install
changelog=
noextract=()
md5sums=() #generate with 'makepkg -g'

package() {
  if [[ ${FLUTTER} ]]; then
	  mkdir -p "${pkgdir}/usr/share/mirvdesk" && cp -r ${HBB}/flutter/build/linux/x64/release/bundle/* -t "${pkgdir}/usr/share/mirvdesk"
  fi
  mkdir -p "${pkgdir}/usr/bin"
  pushd ${pkgdir} && ln -s /usr/share/mirvdesk/mirvdesk usr/bin/mirvdesk && popd
  install -Dm 644 $HBB/res/rustdesk.service "${pkgdir}/usr/share/mirvdesk/files/mirvdesk.service"
  install -Dm 644 $HBB/res/rustdesk.desktop "${pkgdir}/usr/share/mirvdesk/files/mirvdesk.desktop"
  install -Dm 644 $HBB/res/rustdesk-link.desktop "${pkgdir}/usr/share/mirvdesk/files/mirvdesk-link.desktop"
  install -Dm 644 $HBB/res/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/mirvdesk.png"
  install -Dm 644 $HBB/res/scalable.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/mirvdesk.svg"
}
